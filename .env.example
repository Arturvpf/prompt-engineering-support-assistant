# Copie este arquivo para .env e preencha a chave. Nunca versione o .env.

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo usado nas gerações. Mantenha o mesmo modelo ao comparar versões de prompt.
GEMINI_MODEL=gemini-2.5-flash

# Configurações fixas de geração (precisam ser iguais entre v1 e v2 para a comparação ser justa)
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
# Semente para reduzir variação entre execuções ("none" desativa)
LLM_SEED=42
# Orçamento de "thinking" do Gemini 2.5. 0 desativa (mais barato e previsível); "none" usa o padrão do modelo
LLM_THINKING_BUDGET=0

# Tempo limite (segundos) e número de tentativas em caso de erro temporário da API
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Pastas de saída (opcional)
OUTPUT_DIR=outputs
CACHE_DIR=.cache
