# Copie este arquivo para .env e preencha a chave do provedor escolhido. Nunca versione o .env.

# Provedor do LLM: "openrouter" ou "gemini"
LLM_PROVIDER=openrouter

# --- OpenRouter (https://openrouter.ai/keys) ---
# Modelos terminados em ":free" não têm custo, mas têm limite diário de requisições.
# Se o modelo der 429 (limite no provedor), troque por outro ":free" de https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Configurações fixas de geração (precisam ser iguais entre v1 e v2 para a comparação ser justa)
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
# Semente para reduzir variação entre execuções ("none" desativa)
LLM_SEED=42
# Orçamento de raciocínio interno do modelo. 0 desativa (mais barato e previsível); "none" usa o padrão do modelo
LLM_THINKING_BUDGET=0

# Tempo limite (segundos) e número de tentativas em caso de erro temporário da API
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Pasta do histórico de execuções (history.json), que também serve de cache
OUTPUT_DIR=outputs
