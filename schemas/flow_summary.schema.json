{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resumo visual do fluxo",
  "type": "object",
  "required": ["ascii_flowchart", "decision_points"],
  "properties": {
    "ascii_flowchart": {"$ref": "#/$defs/text"},
    "decision_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["question", "if_yes", "if_no"],
        "properties": {
          "question": {"$ref": "#/$defs/text"},
          "if_yes": {"$ref": "#/$defs/text"},
          "if_no": {"$ref": "#/$defs/text"}
        }
      }
    },
    "flow": {
      "description": "v3+: grafo de decisão devolvido pelo modelo; ascii_flowchart e decision_points são desenhados a partir dele",
      "type": "object",
      "required": ["nodes"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "type", "text"],
            "properties": {
              "id": {"$ref": "#/$defs/text"},
              "type": {"type": "string", "enum": ["start", "action", "decision", "end"]},
              "text": {"$ref": "#/$defs/text"},
              "next": {"type": "string"},
              "yes": {"type": "string"},
              "no": {"type": "string"}
            }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "properties": {
        "when": {"type": "string"},
        "attach": {
          "oneOf": [
            {"type": "array", "items": {"type": "string"}},
            {"type": "string"}
          ]
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}
