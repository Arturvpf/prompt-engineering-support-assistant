{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnóstico",
  "type": "object",
  "required": ["hypotheses", "evidence", "missing_information", "probable_conclusion"],
  "properties": {
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "description": {"$ref": "#/$defs/text"},
          "likelihood": {"$ref": "#/$defs/level"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["signal"],
        "properties": {
          "signal": {"$ref": "#/$defs/text"},
          "supports": {"$ref": "#/$defs/ids"},
          "weakens": {"$ref": "#/$defs/ids"}
        }
      }
    },
    "missing_information": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item"],
        "properties": {
          "item": {"$ref": "#/$defs/text"},
          "why_it_matters": {"type": "string"}
        }
      }
    },
    "probable_conclusion": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "hypothesis_id": {"type": "string"},
        "summary": {"$ref": "#/$defs/text"},
        "confidence": {"$ref": "#/$defs/level"},
        "how_to_confirm": {"type": "string"}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "level": {"type": "string", "enum": ["alta", "média", "baixa"]},
    "ids": {"type": "array", "items": {"type": "string"}}
  }
}
