{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Perguntas de esclarecimento",
  "type": "object",
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "priority": {"type": "integer", "minimum": 1},
          "question": {"$ref": "#/$defs/text"},
          "reason": {"type": "string"},
          "how_to_find": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"}
  }
}
